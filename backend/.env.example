# === ServiceFlow AI Backend — Environment Variables ===

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps (optional; set USE_MOCK_MAPS=true to skip real API calls)
GOOGLE_MAPS_API_KEY=your_maps_api_key_here
USE_MOCK_MAPS=true

# Firebase Admin SDK JSON path (relative to backend/)
FIREBASE_CREDENTIALS_JSON_PATH=./firebase-admin.json

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=DEBUG
