# ServiceFlow AI Mobile - Environment Variables

# API Base URL (Required)
# Use your computer's local IP address when running on physical device
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1

# Firebase Configuration (Required)
# These values should match your web app configuration from Firebase Console
EXPO_PUBLIC_FIREBASE_API_KEY=your_web_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:YOUR_ID:web:YOUR_APP_ID
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

